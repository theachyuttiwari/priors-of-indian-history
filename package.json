{
  "name": "priors",
  "version": "0.1.0",
  "private": true,
  "description": "How India’s governments have handled protests: an open, sourced record across every party.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theachyuttiwari/priors-of-indian-history.git"
  },
  "bugs": {
    "url": "https://github.com/theachyuttiwari/priors-of-indian-history/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run cards && next build --webpack",
    "cards": "tsx pipeline/cards.tsx",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx pipeline/validate.ts",
    "archive": "tsx pipeline/archive.ts",
    "match-quotes": "tsx pipeline/match-quotes.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run validate",
    "ingest": "tsx pipeline/ingest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
